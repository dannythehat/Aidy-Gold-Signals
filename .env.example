AIDY_CAPTURE_ENABLED=false
AIDY_MARKET_DATA_SOURCE=metaapi
# These runtime values must come from a genuinely AIDY-dedicated market-data
# connection. Never use the Super Signals owner demo / VantageMarkets-Demo
# account ending 1913 or its MetaAPI token.
AIDY_METAAPI_TOKEN=
AIDY_METAAPI_ACCOUNT_ID=
# Set to aidy_dedicated only after independent ownership is actually verified.
AIDY_MARKET_DATA_OWNERSHIP=
AIDY_MARKET_POLL_SECONDS=60
AIDY_SLOW_POLL_SECONDS=300
AIDY_MARKET_CLOSED_BACKOFF_SECONDS=900
AIDY_MARKET_STALE_SECONDS=300
AIDY_FED_RSS_POLL_SECONDS=120
AIDY_ARCHIVE_FLUSH_LIMIT=100
