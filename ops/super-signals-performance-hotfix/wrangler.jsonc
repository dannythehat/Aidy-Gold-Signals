{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-signals-performance-hotfix",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "supersignals.site/performance*",
      "zone_name": "supersignals.site"
    },
    {
      "pattern": "supersignals.site/data/public-performance.json*",
      "zone_name": "supersignals.site"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ]
}
