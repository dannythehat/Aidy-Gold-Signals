{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aidy-signals-test",
  "main": "src/provider_entry.py",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "AIDY_ENV": "test",
    "AIDY_CAPTURE_ENABLED": "false",
    "AIDY_MARKET_DATA_SOURCE": "gold_api",
    "AIDY_MARKET_DATA_OWNERSHIP": "public_independent",
    "AIDY_MARKET_POLL_SECONDS": "60",
    "AIDY_TWELVE_INTRADAY_SELF_HEAL_ENABLED": "false",
    "AIDY_SLOW_POLL_SECONDS": "300",
    "AIDY_MARKET_CLOSED_BACKOFF_SECONDS": "900",
    "AIDY_MARKET_STALE_SECONDS": "300",
    "AIDY_FED_RSS_POLL_SECONDS": "120",
    "AIDY_MACRO_POLL_SECONDS": "900",
    "AIDY_CROSS_MARKET_POLL_SECONDS": "3600",
    "AIDY_ARCHIVE_FLUSH_LIMIT": "100"
  },
  "secrets": {
    "required": []
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "queues": {
    "consumers": []
  },
  "d1_databases": [
    {
      "binding": "AIDY_OPS",
      "migrations_dir": "migrations/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AIDY_MEMORY"
    }
  ]
}
